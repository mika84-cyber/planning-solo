{
  "name": "planning-solo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-sw.mjs",
    "check": "tsc -b",
    "context:ai": "node scripts/build-ai-context.mjs",
    "preview": "vite preview",
    "test": "vitest run --exclude e2e/**",
    "test:coverage": "vitest run --coverage --exclude e2e/**",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test e2e/accessibility.spec.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:css": "node scripts/check-css-complexity.mjs",
    "check:ci": "npm run check && npm run check:css && npm run test:coverage && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@netlify/identity": "1.2.0",
    "dompurify": "^3.4.13",
    "jspdf": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/functions": "5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "nanoid": "^3.3.18",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
