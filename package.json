{
  "name": "planning-solo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-sw.mjs",
    "check": "tsc -b",
    "lint": "biome lint",
    "context:ai": "node scripts/build-ai-context.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:pdf:visual": "vite build --config vite.pdf-qa.config.ts && node scripts/generate-pdf-qa.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:css": "node scripts/check-css-complexity.mjs",
    "check:ci": "npm run lint && npm run check && npm run check:css && npm run test:coverage && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.2",
    "@netlify/identity": "^2.0.0",
    "jspdf": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
